{
  "name": "kairos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A budget your agent cannot exceed or reveal.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
