{
  "name": "kairos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A budget your agent cannot exceed or reveal.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "contracts"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/frontend dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "test": "bun run test:unit && bun run test:contracts",
    "test:unit": "bun test packages services apps",
    "test:contracts": "bun run --cwd contracts test",
    "deploy:vercel": "bash scripts/deploy-vercel.sh",
    "seed:demo": "bun scripts/seed-demo.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "packageManager": "bun@1.1.0",
  "devDependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
