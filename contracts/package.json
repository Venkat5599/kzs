{
  "name": "@kairos/contracts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Confidential agent-budget vault built on the Nox protocol.",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check 'src/**/*.sol'",
    "deploy:sepolia": "hardhat run script/deploy.ts --network sepolia",
    "prove:live": "bun script/prove-live.ts",
    "prove:flush": "bun script/prove-flush.ts",
    "prove:stealth": "bun script/prove-stealth.ts",
    "prove:stealth-payout": "bun script/prove-stealth-payout.ts",
    "prove:swap": "hardhat run script/prove-swap.ts --network sepolia",
    "deploy:ring": "hardhat run script/deploy-ring.ts --network sepolia"
  },
  "dependencies": {
    "@iexec-nox/handle": "^0.1.0-beta.13",
    "@iexec-nox/nox-protocol-contracts": "^0.2.4",
    "@openzeppelin/contracts": "^5.6.1",
    "encrypted-types": "^0.0.4",
    "@kairos/shared": "workspace:*"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.3",
    "@types/node": "^22",
    "hardhat": "^3.2.0",
    "prettier": "^3.8.1",
    "prettier-plugin-solidity": "^2.3.1",
    "typescript": "^5",
    "viem": "^2.47.6"
  }
}
