# Kairos — environment reference
#
# Copy to .env and fill in. Never commit a filled file; .gitignore covers it.
# Every variable the system reads appears here. Config is schema-validated at
# process start: an invalid value is a boot failure, never a silent default.
#
# Secrets belong to apps/gateway ONLY. If a secret is needed anywhere else,
# the design is wrong. See docs/PROJECT_STRUCTURE.md section 9.

# ─── apps/web ── public. Anything here ships to the browser. ─────────────────

# Gateway base URL the dashboard calls.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# MCP server URL surfaced on the MCP Servers screen.
NEXT_PUBLIC_FABRIC_MCP_URL=http://localhost:8403

# WalletConnect project id. Unset falls back to injected-wallet only, which is
# the path local development uses.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── apps/gateway ── server-side. Never exposed to a client. ─────────────────

GATEWAY_PORT=8080

# Comma-separated allowlist of browser origins permitted to call the gateway.
GATEWAY_CORS_ORIGINS=http://localhost:5173

# ─── chain ───────────────────────────────────────────────────────────────────

CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
CHAIN_EXPLORER_URL=https://sepolia.etherscan.io

# When true the gateway serves stubbed chain responses and performs no real
# settlement. It has exactly one source of truth and is reported verbatim by
# /chain/status, so the dashboard cannot claim a real settlement against a stub.
DEMO_MODE=true

# ─── confidential vault ──────────────────────────────────────────────────────

VAULT_ADDRESS=

# SECRET. The relayer that submits every settlement. Its address is public and
# it learns what it relays — see docs/adr/004-single-relayer.md.
RELAYER_PRIVATE_KEY=

# SECRET. Decrypts the authorization flag. An unreadable flag refuses the
# resource; it never degrades to allowing it — see docs/adr/002-fail-closed.md.
VAULT_DECRYPTION_KEY=

# Settlements per epoch before the batch is eligible for flushing. Longer
# epochs give better timing privacy and worse operator latency.
EPOCH_FLUSH_THRESHOLD=25

# ─── session keys ────────────────────────────────────────────────────────────

# SECRET. Signs scoped agent session keys.
SESSION_KEY_SIGNING_SECRET=

# Default session key lifetime in seconds.
SESSION_KEY_TTL_SECONDS=3600

# ─── workflow engine ─────────────────────────────────────────────────────────

# Hard stop on node executions per run. Guards against runaway graphs.
WORKFLOW_MAX_NODE_EXECUTIONS=500

# Upper bound on items a loop node may iterate.
WORKFLOW_MAX_LOOP_ITEMS=100

# ─── observability ───────────────────────────────────────────────────────────

LOG_LEVEL=info

# No secret, key, or decrypted amount is ever logged, at any level.

# ─── deployed (Ethereum Sepolia) ─────────────────────────────────────────────
# Public addresses. Safe to commit; recorded here so a fresh clone can reach the
# live deployment without hunting through the README.
VAULT_ADDRESS=0xbe6a1a70885540276203d7211dfba0e7be625344
SETTLEMENT_ROUTER_ADDRESS=0xaddf7b8c31fbccfc4a4d71332becd453ca9d2182
UNISWAP_V3_ROUTER=0x3bFA4769FB09eefC5a80d6E87c3B9C650f7Ae48E
NOX_COMPUTE_ADDRESS=0x24Ef36Ec5b626D7DCD09a98F3083c2758F0F77bF

CAP_POLICY_ADDRESS=0x6c262c1e70fa8cb46f3c890dc3dc9a7b8f53307c
VELOCITY_POLICY_ADDRESS=0xe3ad56f18b79bb00073940495ce1f42e618752b5
